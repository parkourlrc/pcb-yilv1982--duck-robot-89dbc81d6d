    "91: +    fn imu_to_dxl_read(&mut self, deadline: Instant) -> Result<Vec<u8>> {",
    "92: +        let started = Instant::now();",
    "93: +        let params = [SYNC_ADDRESS, IMU_LENGTH];",
    "94: +        let mut decoder = Decoder::default();",
    "95: +        let mut trace = SyncTrace {",
    "96: +            address: SYNC_ADDRESS,",
    "97: +            length: IMU_LENGTH,",
    "98: +            missing_ids: vec![IMU_ID],",
    "99: +            ..SyncTrace::default()",
    "100: +        };",
    "101: +        let mut echo_bytes = 0;",
    "102: +        let result = (|| {",
    "103: +            self.send(&packet(IMU_ID, READ, &params)?, deadline)?;",
    "104: +            trace.request_sent = true;",
    "105: +            self.observations.requested(&[IMU_ID], Instant::now());",
    "106: +            let mut chunk = [0u8; 128];",
    "107: +            while Instant::now() < deadline {",
    "108: +                if self.poll_timeout(deadline).is_err() {",
    "109: +                    break;",
    "110: +                }",
    "111: +                match self.port.read(&mut chunk) {",
    "112: +                    Ok(count) => {",
    "113: +                        trace.rx_bytes += count;",
    "114: +                        let mut answer = None;",
    "115: +                        for byte in &chunk[..count] {",
    "116: +                            if let Some(status) = decoder.push(*byte) {",
    "117: +                                if status.id != IMU_ID {",
    "118: +                                    continue;",
    "119: +                                }",
    "120: +                                // A half-duplex request echo is not a status-error reply.",
    "121: +                                if status.error == READ && status.data == params {",
    "122: +                                    echo_bytes += status.data.len() + 6;",
    "123: +                                    continue;",
    "124: +                                }",
    "125: +                                self.last_imu_response_at = Some(Instant::now());",
    "126: +                                self.observations.replied(",
    "127: +                                    &status,",
    "128: +                                    SYNC_ADDRESS,",
    "129: +                                    IMU_LENGTH,",
    "130: +                                    Instant::now(),",
    "131: +                                );",
    "132: +                                if status.error != 0 {",
    "133: +                                    return Err(error(format!(",
    "134: +                                        \"imu_to_dxl ID200 status error 0x{:02x}\",",
    "135: +                                        status.error,",
    "136: +                                    )));",
    "137: +                                }",
    "138: +                                if status.data.len() != usize::from(IMU_LENGTH) {",
    "139: +                                    return Err(error(\"imu_to_dxl ID200 requires 56/15\"));",
    "140: +                                }",
    "141: +                                if answer.is_some() {",
    "142: +                                    return Err(error(\"duplicate imu_to_dxl ID200 reply\"));",
    "143: +                                }",
    "144: +                                answer = Some(status.data);",
    "145: +                            }",
    "146: +                        }",
    "147: +                        if let Some(raw) = answer {",
    "148: +                            // Include a foreign frame or a noise tail in the trace so a",
    "149: +                            // noisy IMU half cannot qualify for partial servo acceptance.",
    "150: +                            trace.discarded =",
    "151: +                                trace.rx_bytes.saturating_sub(raw.len() + 6 + echo_bytes) as u64;",
    "152: +                            if decoder.bad_checksums != 0 {",
    "153: +                                return Err(error(\"imu_to_dxl ID200 checksum error\"));",
    "154: +                            }",
    "155: +                            if Instant::now() >= deadline {",
    "156: +                                trace.complete_but_late = true;",
    "157: +                                return Err(error(\"imu_to_dxl ID200 response exceeded deadline\"));",
    "158: +                            }",
    "159: +                            return Ok(raw);",
    "160: +                        }",
    "161: +                    }",
    "162: +                    Err(e)",
    "163: +                        if matches!(",
    "164: +                            e.kind(),",
    "165: +                            std::io::ErrorKind::TimedOut",
    "166: +                                | std::io::ErrorKind::WouldBlock",
    "167: +                                | std::io::ErrorKind::Interrupted",
    "168: +                        ) => {}",
    "169: +                    Err(e) => return Err(error(e.to_string())),",
    "170: +                }",
    "171: +            }",
    "172: +            Err(error(\"imu_to_dxl ID200 response timeout\"))",
    "173: +        })();",
    "174: +        trace.elapsed_us = started.elapsed().as_micros() as u64;",
    "175: +        trace.deadline_exceeded = Instant::now() >= deadline;",
    "176: +        trace.bad_checksums = decoder.bad_checksums;",
    "177: +        trace.discarded = trace.discarded.max(decoder.discarded);",
    "178: +        if result.is_ok() {",
