(version 1)
(rule "Through via annular ring" (condition "A.Type == 'Via'") (constraint annular_width (min 0.15mm)) (constraint hole_size (min 0.3mm)) (constraint via_diameter (min 0.6mm)))
(rule "Via copper clearance" (condition "A.Type == 'Via'") (constraint hole_clearance (min 0.2mm)))
(rule "PTH copper clearance" (condition "A.Type == 'Pad' && A.isPlated() && A.Hole_Size_X > 0mm") (constraint hole_clearance (min 0.3mm)))
(rule "NPTH copper clearance" (condition "A.Type == 'Pad' && !A.isPlated() && A.Hole_Size_X > 0mm") (constraint hole_clearance (min 0.25mm)))
