/dts-v1/;
/plugin/;

/ {
    compatible = "radxa,zero3", "rockchip,rk3566";

    fragment@0 {
        target-path = "/";
        __overlay__ {
            hat_revb_mclk: clock-hat-revb {
                compatible = "fixed-clock";
                #clock-cells = <0>;
                clock-frequency = <12000000>;
                clock-output-names = "hat_revb_12mhz";
            };

            hat_revb_1v8: regulator-hat-revb-1v8 {
                compatible = "regulator-fixed";
                regulator-name = "hat_revb_1v8";
                regulator-min-microvolt = <1800000>;
                regulator-max-microvolt = <1800000>;
                regulator-always-on;
                regulator-boot-on;
                vin-supply = <&vcc3v3_sys>;
            };

            sound-duck-hat-revb {
                compatible = "simple-audio-card";
                simple-audio-card,name = "DuckHATB";
                simple-audio-card,format = "i2s";
                simple-audio-card,bitclock-master = <&hat_revb_codec_dai>;
                simple-audio-card,frame-master = <&hat_revb_codec_dai>;
                simple-audio-card,widgets =
                    "Speaker", "HAT Speaker",
                    "Microphone", "HAT Onboard Mic",
                    "Microphone", "HAT External Left",
                    "Microphone", "HAT External Right";
                simple-audio-card,routing =
                    "HAT Speaker", "RLOUT",
                    "MIC2R", "HAT Onboard Mic",
                    "LINE1L", "HAT External Left",
                    "LINE1R", "HAT External Right",
                    "HAT External Left", "Mic Bias",
                    "HAT External Right", "Mic Bias";

                hat_revb_cpu: simple-audio-card,cpu {
                    sound-dai = <&i2s3_2ch>;
                };

                hat_revb_codec_dai: simple-audio-card,codec {
                    sound-dai = <&hat_revb_codec>;
                    clocks = <&hat_revb_mclk>;
                    system-clock-frequency = <12000000>;
                    system-clock-fixed;
                };
            };
        };
    };

    fragment@1 {
        target = <&pinctrl>;
        __overlay__ {
            duck-hat-revb {
                hat_revb_reset: codec-reset {
                    rockchip,pins = <3 19 0 &pcfg_pull_none>;
                };
            };
        };
    };

    fragment@2 {
        target = <&i2c5>;
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;
            status = "okay";
            clock-frequency = <100000>;
            pinctrl-names = "default";
            pinctrl-0 = <&i2c5m0_xfer>;

            hat_revb_codec: codec@18 {
                compatible = "ti,tlv320aic3104";
                reg = <0x18>;
                #sound-dai-cells = <0>;
                pinctrl-names = "default";
                pinctrl-0 = <&hat_revb_reset>;
                reset-gpios = <&gpio3 19 1>;
                IOVDD-supply = <&vcc3v3_sys>;
                AVDD-supply = <&vcc3v3_sys>;
                DRVDD-supply = <&vcc3v3_sys>;
                DVDD-supply = <&hat_revb_1v8>;
                ai3x-micbias-vg = <1>;
            };
        };
    };

    fragment@3 {
        target = <&i2s3_2ch>;
        __overlay__ {
            status = "okay";
            rockchip,trcm-sync-tx-only;
            pinctrl-names = "default";
            pinctrl-0 = <&i2s3m0_sclk &i2s3m0_lrck &i2s3m0_sdi &i2s3m0_sdo>;
        };
    };
};
