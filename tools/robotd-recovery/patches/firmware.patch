+//! Explicit, leased recovery with the installed joint Walk policy.
+//! No IO lives here: the control thread owns torque and the last pre-write fence.
+use crate::{home_start, intents::RecoveryRequest};
+use arc_swap::{ArcSwap, ArcSwapOption};
+use serde::Serialize;
+use std::{
+    sync::{
+        Arc,
+        atomic::{AtomicU64, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+pub const LEASE: Duration = Duration::from_millis(500);
+pub const TIMEOUT: Duration = Duration::from_secs(8);
+const STABLE: Duration = Duration::from_secs(1);
+
+#[derive(Clone)]
+pub struct Ticket {
+    pub id: u64,
+    pub activation: RecoveryRequest,
+    pub seen: Instant,
+    pub sequence: u64,
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct Report {
+    pub phase: &'static str,
+    pub request_id: Option<u64>,
+    pub reason: String,
+    pub elapsed_ms: u64,
+    pub torque_state_confirmed: Option<bool>,
+}
+impl Report {
+    pub fn active(&self) -> bool {
+        matches!(
+            self.phase,
+            "starting" | "recovering" | "recovered_hold" | "stopping"
+        )
+    }
+}
+impl Default for Report {
+    fn default() -> Self {
+        Self {
+            phase: "idle",
+            request_id: None,
+            reason: "等待明确点击躺姿起身".into(),
+            elapsed_ms: 0,
+            torque_state_confirmed: None,
+        }
+    }
+}
+
+pub struct Mailbox {
+    ticket: ArcSwapOption<Ticket>,
+    pub report: ArcSwap<Report>,
+    next_id: AtomicU64,
+    handoff: AtomicU64,
+}
+impl Default for Mailbox {
+    fn default() -> Self {
+        Self {
+            ticket: ArcSwapOption::empty(),
+            report: ArcSwap::from_pointee(Report::default()),
+            next_id: AtomicU64::new(duck_ipc_proto::clock::monotonic_ns() / 1000),
+            handoff: AtomicU64::new(0),
+        }
+    }
+}
+impl Mailbox {
+    pub fn ticket(&self) -> Option<Arc<Ticket>> {
+        self.ticket.load_full()
+    }
+    pub fn active(&self) -> bool {
+        self.ticket.load().is_some() || self.report.load().active()
+    }
+    pub fn start(&self, activation: RecoveryRequest, now: Instant) -> Result<u64, &'static str> {
+        if self.report.load().active() {
+            return Err("恢复尚未结束，请先停止");
+        }
+        let id = self.next_id.fetch_add(1, Ordering::SeqCst);
+        let ticket = Arc::new(Ticket {
+            id,
+            activation,
+            seen: now,
+            sequence: 0,
+        });
+        let previous = self
+            .ticket
+            .compare_and_swap(&None::<Arc<Ticket>>, Some(ticket));
+        if previous.is_some() {
+            return Err("恢复请求已经存在");
+        }
+        self.report.store(Arc::new(Report {
+            phase: "starting",
+            request_id: Some(id),
+            reason: "请求已接收，等待控制线程复核".into(),
+            ..Report::default()
+        }));
+        Ok(id)
+    }
+    pub fn keepalive(&self, id: u64, sequence: u64, now: Instant) -> Result<(), &'static str> {
+        loop {
+            let old = self.ticket().ok_or("恢复已结束；旧心跳不能重新启动")?;
+            if old.id != id
+                || sequence <= old.sequence
+                || now.saturating_duration_since(old.seen) >= LEASE
+            {
+                return Err("恢复心跳过期、序号重复或请求不匹配");
+            }
+            let next = Arc::new(Ticket {
+                seen: now,
+                sequence,
+                ..(*old).clone()
+            });
+            let previous = self.ticket.compare_and_swap(&Some(old.clone()), Some(next));
+            if previous.as_ref().is_some_and(|p| Arc::ptr_eq(p, &old)) {
+                return Ok(());
+            }
+        }
+    }
+    pub fn current(&self, id: u64, now: Instant) -> bool {
+        self.ticket()
+            .is_some_and(|t| t.id == id && now.saturating_duration_since(t.seen) < LEASE)
+    }
+    pub fn cancel(&self, reason: &str) {
+        if self.ticket.swap(None).is_some() {
+            let old = self.report.load_full();
+            self.report.store(Arc::new(Report {
+                phase: "stopping",
+                reason: reason.into(),
+                ..(*old).clone()
+            }));
+        }
+        self.handoff.store(0, Ordering::SeqCst);
+    }
+    pub fn handoff(&self) -> Result<(), &'static str> {
+        let r = self.report.load();
+        if r.phase != "recovered_hold" {
+            return Err("姿态尚未恢复，不能开始走");
+        }
+        let id = r.request_id.ok_or("没有恢复请求")?;
+        if !self.current(id, Instant::now()) {
+            return Err("恢复会话已经过期");
+        }
+        self.handoff.store(id, Ordering::SeqCst);
+        Ok(())
+    }
+    pub fn take_handoff(&self, id: u64) -> bool {
+        self.handoff.swap(0, Ordering::SeqCst) == id
+    }
+    pub fn finish(&self, phase: &'static str, reason: &str, torque: Option<bool>) {
+        self.ticket.store(None);
+        self.handoff.store(0, Ordering::SeqCst);
+        let old = self.report.load_full();
+        self.report.store(Arc::new(Report {
+            phase,
+            reason: reason.into(),
+            torque_state_confirmed: torque,
+            ..(*old).clone()
+        }));
+    }
+}
+
+pub struct Session {
+    pub id: u64,
+    first_output: Option<Instant>,
+    stable_since: Option<Instant>,
+    unstable_since: Option<Instant>,
+    holding: bool,
+}
+impl Session {
+    pub fn new(id: u64) -> Self {
+        Self {
+            id,
+            first_output: None,
+            stable_since: None,
+            unstable_since: None,
+            holding: false,
+        }
+    }
+    pub fn first_output(&mut self, now: Instant) {
+        self.first_output.get_or_insert(now);
+    }
+    pub fn check(
+        &mut self,
+        now: Instant,
+        mailbox: &Mailbox,
+        valid: bool,
+        pose: bool,
+    ) -> Result<(), &'static str> {
+        if !mailbox.current(self.id, now) {
+            return Err("恢复已取消或网页心跳超过500 ms");
+        }
+        if !valid {
+            return Err("恢复需要每拍完整的新鲜关节和就绪IMU");
+        }
+        let Some(start) = self.first_output else {
+            return Ok(());
+        };
+        let elapsed = now.saturating_duration_since(start);
+        if !self.holding {
+            if elapsed >= TIMEOUT {
+                return Err("8秒内未满足姿态恢复判据");
+            }
+            if pose {
+                let since = self.stable_since.get_or_insert(now);
+                if now.saturating_duration_since(*since) >= STABLE {
+                    self.holding = true;
+                }
+            } else {
+                self.stable_since = None;
+            }
+        } else if pose {
+            self.unstable_since = None;
+        } else {
+            let since = self.unstable_since.get_or_insert(now);
+            if now.saturating_duration_since(*since) >= STABLE {
+                return Err("恢复保持再次失去姿态判据");
+            }
+        }
+        mailbox.report.store(Arc::new(Report {
+            phase: if self.holding {
+                "recovered_hold"
+            } else {
+                "recovering"
+            },
+            request_id: Some(self.id),
+            reason: if self.holding {
+                "姿态已恢复，零速度保持"
+            } else {
+                "正在尝试躺姿起身"
+            }
+            .into(),
+            elapsed_ms: elapsed.as_millis() as u64,
+            torque_state_confirmed: Some(true),
+        }));
+        Ok(())
+    }
+    pub fn holding(&self) -> bool {
+        self.holding
+    }
+}
+
+pub fn pose_ready(report: &home_start::Report) -> bool {
+    report.ready && report.recovery_sensors_ready
+}
