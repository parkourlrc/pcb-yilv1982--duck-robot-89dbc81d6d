+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::intents::Intents;
+    #[test]
+    fn duplicate_start_and_heartbeat_do_not_restart_deadline() {
+        let i = Intents::new();
+        let now = Instant::now();
+        let id = i.request_walk_recovery(now).unwrap();
+        assert!(i.request_walk_recovery(now).is_err());
+        assert!(i.walk_recovery.keepalive(id, 1, now).is_ok());
+        assert!(i.walk_recovery.keepalive(id, 1, now).is_err());
+        assert!(i.walk_recovery.keepalive(id, 2, now + LEASE).is_err());
+        assert!(!i.walk_recovery.current(id, now + LEASE));
+    }
+    #[test]
+    fn taken_start_cannot_outlive_relax_or_init() {
+        for init in [false, true] {
+            let i = Intents::new();
+            i.request_walk_recovery(Instant::now()).unwrap();
+            let t = i.walk_recovery.ticket().unwrap();
+            if init {
+                i.request_init();
+            } else {
+                i.request_relax();
+            }
+            assert!(!i.activate_home_skill(t.activation));
+            assert!(!i.walk_recovery.current(t.id, Instant::now()));
+            assert!(!i.enabled());
+        }
+    }
+    #[test]
+    fn recovery_needs_continuous_pose_and_exits_on_new_instability() {
+        let i = Intents::new();
+        let now = Instant::now();
+        let id = i.request_walk_recovery(now).unwrap();
+        let mut session = Session::new(id);
+        session.first_output(now);
+        for n in 1..=11 {
+            let at = now + Duration::from_millis(n * 100);
+            i.walk_recovery.keepalive(id, n, at).unwrap();
+            session.check(at, &i.walk_recovery, true, true).unwrap();
+        }
+        assert!(session.holding());
+        for n in 12..=22 {
+            let at = now + Duration::from_millis(n * 100);
+            i.walk_recovery.keepalive(id, n, at).unwrap();
+            let r = session.check(at, &i.walk_recovery, true, false);
+            assert_eq!(r.is_err(), n == 22);
+        }
+    }
+    #[test]
+    fn bad_feedback_and_timeout_abort_even_with_fresh_lease() {
+        let i = Intents::new();
+        let now = Instant::now();
+        let id = i.request_walk_recovery(now).unwrap();
+        let mut s = Session::new(id);
+        s.first_output(now);
+        assert!(s.check(now, &i.walk_recovery, false, false).is_err());
+        for n in 1..=80 {
+            let at = now + Duration::from_millis(n * 100);
+            i.walk_recovery.keepalive(id, n, at).unwrap();
+            assert_eq!(s.check(at, &i.walk_recovery, true, false).is_err(), n == 80);
+        }
+    }
