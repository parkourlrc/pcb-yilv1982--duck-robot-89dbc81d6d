+function RecoveryCard({ recovery, link }) {
+  const lease = useRef(null), mounted = useRef(true), starting = useRef(false);
+  const [error, setError] = useState(null);
+  const status = useRef(recovery); status.current = recovery;
+  useEffect(() => {
+    mounted.current = true;
+    let pending = false;
+    const cancel = () => {
+      const r = lease.current; lease.current = null;
+      if (r) link.cmd('pad.op', { op: 'recover_cancel', request_id: r.id }, 2000);
+    };
+    const tick = async () => {
+      const r = lease.current;
+      if (!r || pending) return;
+      if (!ACT.active || document.visibilityState !== 'visible') { cancel(); return; }
+      const st = status.current;
+      if (st?.request_id === r.id && !st.active) { lease.current = null; return; }
+      pending = true;
+      try {
+        const result = await link.cmd('pad.op', { op: 'recover_keepalive', request_id: r.id, sequence: ++r.seq }, 500);
+        if (!result.ok && lease.current === r) lease.current = null;
+      } catch {
+        if (lease.current === r) lease.current = null;
+      } finally { pending = false; }
+    };
+    const timer = setInterval(tick, SEND_MS);
+    const off = padActivity.subscribe(({ active }) => { if (!active) cancel(); });
+    const blur = () => cancel();
+    const key = (e) => {
+      if (e.code === 'Escape' || e.code === 'Space') {
+        if (status.current?.active) link.cmd('pad.op', { op: 'recover_cancel' }, 2000);
+        lease.current = null;
+      }
+    };
+    window.addEventListener('blur', blur);
+    window.addEventListener('keydown', key, true);
+    return () => {
+      mounted.current = false; clearInterval(timer); off();
+      window.removeEventListener('blur', blur); cancel();
+      window.removeEventListener('keydown', key, true);
+    };
+  }, []);
+  const start = async () => {
+    if (starting.current || lease.current || !ACT.active) return;
+    starting.current = true; setError(null);
+    try {
+      const r = await link.cmd('pad.op', { op: 'recover' }, 3000);
+      const id = r.data?.request_id;
+      if (r.ok && Number.isSafeInteger(id)) {
+        if (mounted.current && ACT.active && document.visibilityState === 'visible') lease.current = { id, seq: 0 };
+        else link.cmd('pad.op', { op: 'recover_cancel', request_id: id }, 2000);
+      } else if (mounted.current) setError(r.reason || '主程序没有接受恢复请求');
+    } catch {
+      if (mounted.current) setError('连接中断，恢复不会继续续期');
+    } finally { starting.current = false; }
+  };
+  const stop = () => { lease.current = null; link.cmd('pad.op', { op: 'recover_cancel' }, 2000); };
+  return html`<div class="pd-sec">
+    <div class="pd-sec-h">躺姿起身</div>
+    <p class="pd-small-p">最长尝试8秒，恢复后零速度保持。停止、Esc、断连或失败会卸力；起身前请留出活动空间。</p>
+    <div class="pd-bigs">
+      <button class="pd-big" disabled=${!recovery?.ok || recovery?.active} onClick=${start}><b>躺姿起身</b><small>${recovery?.why || '使用已装联合模型'}</small></button>
+      ${recovery?.active ? html`<button class="pd-big pd-stopbtn" onClick=${stop}><b>停止并卸力</b></button>` : null}
+    </div>
+    <p class="pd-small-p" role="status">${error || recovery?.reason || '主程序尚未安装躺姿恢复功能'}</p>
+  </div>`;
 }
 
