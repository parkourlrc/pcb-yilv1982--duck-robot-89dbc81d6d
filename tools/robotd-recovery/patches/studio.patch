+"""网页恢复会话。只有仍在页面的所有者能续期，后台线程不代发心跳。"""
+from .pad_combo import Refused
+
+ACTIVE = {"starting", "recovering", "recovered_hold", "stopping"}
+
+
+class RecoveryMixin:
+    def _recovery_status(self):
+        bus = (self._robot or {}).get("bus") or {}
+        status = bus.get("walk_recovery")
+        return status if isinstance(status, dict) else {}
+
+    def _recovery_active(self):
+        owner = self._recovery_owner
+        pending = owner is not None and owner.get("request_id") is None
+        return pending or self._recovery_status().get("phase") in ACTIVE
+
+    def _recovery_view(self, now):
+        status = self._recovery_status()
+        bus = (self._robot or {}).get("bus") or {}
+        why = self._base_block(now) or self._relax_block(now)
+        if why is None and not status:
+            why = "主程序尚未安装躺姿恢复功能"
+        model = (bus.get("loaded_models") or {}).get("walk") or {}
+        if why is None and model.get("sha256") != "1cbf8730eadd75a5704332c9f3c10f60bfa9412135b907831c9dbd731ce1795f":
+            why = "本次使用的联合行走模型尚未加载"
+        if why is None and self._recovery_active():
+            why = "本次恢复尚未结束"
+        if why is None and bus.get("policy_enabled") is not False:
+            why = "先关闭普通策略，再从躺姿启动恢复"
+        if why is None and self._pad_attached(now)[0] is not False:
+            why = "请先断开实体手柄，确认由网页控制"
+        if why is None and (self._action or self.motion_studio.session or self._job_alive()):
+            why = "先结束其他动作或手柄配对任务"
+        return {**status, "available": bool(status), "active": self._recovery_active(),
+                "ok": why is None, "why": why}
+
+    def _recovery_op(self, op, args, conn, by):
+        if op == "recover_cancel":
+            # Anyone may stop; this also covers an owner whose browser lost its lease.
+            request_id = args.get("request_id")
+            if request_id is not None:
+                self._call_rpc("取消本次躺姿恢复", "robot.recover",
+                               {"action": "cancel", "request_id": request_id}, by)
+            else:
+                self._call_rpc("停止躺姿恢复", "robot.relax", {}, by)
+            with self._lk:
+                if request_id is None or (self._recovery_owner or {}).get("request_id") == request_id:
+                    self._recovery_owner = None
+            return {"accepted": True}
+
+        with self._send_lk:
+            with self._lk:
+                now = self.clock()
+                if conn is None or conn in self._gone or conn in self._closed:
+                    raise Refused("页面已经离开或断开，恢复请求已丢弃")
+                if not self.motion_studio.request_current():
+                    raise Refused("动作会话已改变，恢复请求已丢弃")
+                if op == "recover_keepalive":
+                    owner = self._recovery_owner
+                    sequence = args.get("sequence")
+                    if (owner is None or owner["conn"] != conn
+                            or owner.get("request_id") != args.get("request_id")
+                            or type(sequence) is not int or sequence <= owner["sequence"]
+                            or self._relax_at >= owner["started"]
+                            or not self._driver or self._driver["conn"] != conn
+                            or self._base_block(now)):
+                        raise Refused("恢复会话失效或心跳不是当前所有者发出")
+                    owner["sequence"] = sequence
+                    self._touch_lease(conn, now)
+                    params = {"action": "keepalive", "request_id": owner["request_id"], "sequence": sequence}
+                else:
+                    view = self._recovery_view(now)
+                    if not view["ok"]:
+                        raise Refused(view["why"])
+                    if self._cmd_busy:
+                        raise Refused("上一个命令还没完成")
+                    self._take_lease(conn, by, now)
+                    owner = {"conn": conn, "request_id": None, "sequence": 0, "started": now}
+                    self._recovery_owner = owner
+                    self._cmd_busy = True
+                    params = {}
+            try:
+                result = self._call_rpc("躺姿起身" if op == "recover" else "恢复心跳", "robot.recover", params, by)
+                if op == "recover":
+                    request_id = result.get("request_id")
+                    if type(request_id) is not int or request_id <= 0:
+                        raise Refused("主程序没有返回本次恢复编号；不发送续期")
+                    with self._lk:
+                        valid = (self._recovery_owner is owner and conn not in self._gone
+                                 and conn not in self._closed and self._relax_at < owner["started"]
+                                 and self.motion_studio.request_current())
+                        if valid:
+                            owner["request_id"] = request_id
+                    if not valid:
+                        self._call_rpc("取消已过期恢复", "robot.recover",
+                                       {"action": "cancel", "request_id": request_id}, by)
+                        raise Refused("等待回执时页面已离开或会话已取消")
+                return result
+            except Exception:
+                with self._lk:
+                    if self._recovery_owner is owner:
+                        self._recovery_owner = None
+                raise
+            finally:
+                if op == "recover":
+                    with self._lk:
+                        self._cmd_busy = False
+
+    def _recovery_buttons(self, now, buttons, skills, actions, combos):
+        view = self._recovery_view(now)
+        if view["active"]:
+            for row in [*buttons.values(), *skills, *actions, *combos]:
+                row.update(ok=False, why="躺姿恢复中，其他动作暂不可用")
+            buttons["walk"] = {"op": "walk" if view.get("phase") == "recovered_hold" else "recover_cancel",
+                               "label": "开始走" if view.get("phase") == "recovered_hold" else "停止并卸力",
+                               "call": "robot.enable" if view.get("phase") == "recovered_hold" else "robot.relax",
+                               "ok": True, "why": None}
+        return view
