+                                }
+                                if status.data.len() != usize::from(IMU_LENGTH) {
+                                    return Err(error("imu_to_dxl ID200 requires 56/15"));
+                                }
+                                if answer.is_some() {
+                                    return Err(error("duplicate imu_to_dxl ID200 reply"));
+                                }
+                                answer = Some(status.data);
+                            }
+                        }
+                        if let Some(raw) = answer {
+                            // Include a foreign frame or a noise tail in the trace so a
+                            // noisy IMU half cannot qualify for partial servo acceptance.
+                            trace.discarded =
+                                trace.rx_bytes.saturating_sub(raw.len() + 6 + echo_bytes) as u64;
+                            if decoder.bad_checksums != 0 {
+                                return Err(error("imu_to_dxl ID200 checksum error"));
+                            }
+                            if Instant::now() >= deadline {
+                                trace.complete_but_late = true;
+                                return Err(error("imu_to_dxl ID200 response exceeded deadline"));
+                            }
+                            return Ok(raw);
+                        }
+                    }
+                    Err(e)
+                        if matches!(
+                            e.kind(),
+                            std::io::ErrorKind::TimedOut
+                                | std::io::ErrorKind::WouldBlock
+                                | std::io::ErrorKind::Interrupted
+                        ) => {}
+                    Err(e) => return Err(error(e.to_string())),
+                }
+            }
+            Err(error("imu_to_dxl ID200 response timeout"))
+        })();
+        trace.elapsed_us = started.elapsed().as_micros() as u64;
+        trace.deadline_exceeded = Instant::now() >= deadline;
+        trace.bad_checksums = decoder.bad_checksums;
+        trace.discarded = trace.discarded.max(decoder.discarded);
+        if result.is_ok() {
+            trace.missing_ids.clear();
+        }
+        self.last_sync = trace;
+        result
