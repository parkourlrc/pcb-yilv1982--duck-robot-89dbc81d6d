+    fn imu_to_dxl_read(&mut self, deadline: Instant) -> Result<Vec<u8>> {
+        let started = Instant::now();
+        let params = [SYNC_ADDRESS, IMU_LENGTH];
+        let mut decoder = Decoder::default();
+        let mut trace = SyncTrace {
+            address: SYNC_ADDRESS,
+            length: IMU_LENGTH,
+            missing_ids: vec![IMU_ID],
+            ..SyncTrace::default()
+        };
+        let mut echo_bytes = 0;
+        let result = (|| {
+            self.send(&packet(IMU_ID, READ, &params)?, deadline)?;
+            trace.request_sent = true;
+            self.observations.requested(&[IMU_ID], Instant::now());
+            let mut chunk = [0u8; 128];
+            while Instant::now() < deadline {
+                if self.poll_timeout(deadline).is_err() {
+                    break;
+                }
+                match self.port.read(&mut chunk) {
+                    Ok(count) => {
+                        trace.rx_bytes += count;
+                        let mut answer = None;
+                        for byte in &chunk[..count] {
+                            if let Some(status) = decoder.push(*byte) {
+                                if status.id != IMU_ID {
+                                    continue;
+                                }
+                                // A half-duplex request echo is not a status-error reply.
+                                if status.error == READ && status.data == params {
+                                    echo_bytes += status.data.len() + 6;
+                                    continue;
+                                }
+                                self.last_imu_response_at = Some(Instant::now());
+                                self.observations.replied(
+                                    &status,
+                                    SYNC_ADDRESS,
+                                    IMU_LENGTH,
+                                    Instant::now(),
+                                );
+                                if status.error != 0 {
+                                    return Err(error(format!(
+                                        "imu_to_dxl ID200 status error 0x{:02x}",
+                                        status.error,
