+//! Transport regression tests for this robot's v0.3 / replica 0.2.0 integration.
+use super::*;
+use crate::model::JOINT_IDS;
+use serialport::SerialPort;
+use std::sync::{
+    Arc, Mutex,
+    atomic::{AtomicBool, Ordering},
+};
+
+#[derive(Clone, Copy)]
+enum Fault {
+    None,
+    Echo,
+    MissingImu,
+    WrongId,
+    Short,
+    Status,
+    Checksum,
+    MissingServo,
+    NoiseAndMissingServo,
+    UnreadyAndMissingServo,
+    LateServos,
+}
+
+struct Peer {
+    stop: Arc<AtomicBool>,
+    requests: Arc<Mutex<Vec<Vec<u8>>>>,
+    worker: Option<std::thread::JoinHandle<()>>,
+}
+impl Drop for Peer {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+        self.worker.take().unwrap().join().unwrap();
+    }
+}
+
+fn peer(fault: Fault) -> (Bus, Peer) {
+    let (mut device, mut host) = serialport::TTYPort::pair().unwrap();
+    device.set_timeout(Duration::from_millis(2)).unwrap();
+    host.set_timeout(Duration::from_millis(2)).unwrap();
+    let stop = Arc::new(AtomicBool::new(false));
+    let done = stop.clone();
+    let requests = Arc::new(Mutex::new(Vec::new()));
+    let seen = requests.clone();
+    let worker = std::thread::spawn(move || {
+        let mut pending = Vec::new();
+        let mut byte = [0];
+        while !done.load(Ordering::Relaxed) {
+            if device.read(&mut byte).unwrap_or(0) == 0 {
+                continue;
+            }
+            pending.push(byte[0]);
+            if pending.len() < 4 || pending.len() < usize::from(pending[3]) + 4 {
+                continue;
+            }
+            let tx = std::mem::take(&mut pending);
+            seen.lock().unwrap().push(tx.clone());
+            if tx[4] == READ {
+                if matches!(fault, Fault::MissingImu) {
+                    continue;
+                }
+                let mut raw = vec![0; usize::from(IMU_LENGTH)];
+                raw[6..8].copy_from_slice(&0x2e66u16.to_le_bytes());
+                raw[12] = 1;
+                raw[13] = if matches!(fault, Fault::UnreadyAndMissingServo) {
+                    1
+                } else {
+                    8
+                };
+                if matches!(fault, Fault::Short) {
+                    raw.pop();
+                }
+                if matches!(fault, Fault::LateServos) {
+                    std::thread::sleep(Duration::from_millis(12));
+                }
+                let id = if matches!(fault, Fault::WrongId) {
+                    199
+                } else {
+                    IMU_ID
+                };
+                let status = if matches!(fault, Fault::Status) { 4 } else { 0 };
+                let mut reply = packet(id, status, &raw).unwrap();
+                if matches!(fault, Fault::Checksum) {
+                    *reply.last_mut().unwrap() ^= 1;
+                }
+                if matches!(fault, Fault::Echo) {
+                    reply.splice(0..0, tx);
+                }
+                if matches!(fault, Fault::NoiseAndMissingServo) {
+                    reply.push(0x12);
+                }
+                let _ = device.write_all(&reply);
+            } else if tx[4] == SYNC_READ {
+                if matches!(fault, Fault::LateServos) {
+                    std::thread::sleep(Duration::from_millis(12));
+                }
+                let mut reply = Vec::new();
+                for (index, id) in tx[7..tx.len() - 1].iter().enumerate() {
+                    if index == 0
+                        && matches!(
+                            fault,
+                            Fault::MissingServo
+                                | Fault::NoiseAndMissingServo
+                                | Fault::UnreadyAndMissingServo
+                        )
+                    {
+                        continue;
+                    }
+                    reply.extend(packet(*id, 0, &[0; 15]).unwrap());
+                }
+                let _ = device.write_all(&reply);
+            }
+        }
+    });
+    let bus = Bus {
+        port: Box::new(host),
+        timeout: Duration::from_millis(30),
+        read_only: true,
+        last_sync: SyncTrace::default(),
+        imu_board: BusImuBoard::ImuToDxl,
+        imu_protocol: BusImuProtocol::Feetech,
+        imu_profile: BusImuProfile::Legacy,
+        imu_identity: Some(vec![0, 2, 0, 0x44, 0x4d]),
+        observations: observations::Observations::default(),
+        last_imu_response_at: None,
+    };
+    (
+        bus,
+        Peer {
+            stop,
+            requests,
+            worker: Some(worker),
+        },
+    )
+}
+
+#[test]
+fn v03_sends_unicast_then_fifteen_servos_for_both_entry_points() {
+    for partial in [false, true] {
+        let (mut bus, peer) = peer(Fault::None);
+        let blocks = if partial {
+            bus.telemetry_partial(&JOINT_IDS)
+        } else {
+            bus.telemetry(&JOINT_IDS)
+        }
+        .unwrap();
+        assert_eq!(blocks.len(), 16);
+        let requests = peer.requests.lock().unwrap();
+        assert_eq!(requests[0], packet(IMU_ID, READ, &[56, 15]).unwrap());
+        assert_eq!(requests[1], sync_read_packet(56, 15, &JOINT_IDS).unwrap());
+        assert_eq!(requests.len(), 2);
+        assert_eq!(bus.last_sync.rx_bytes, 16 * 21);
+        assert!(bus.last_sync.missing_ids.is_empty());
+        assert!(bus.last_imu_response_at.is_some());
+        assert!(bus.decode_imu(&blocks[&IMU_ID]).unwrap().ready);
+    }
+}
+
+#[test]
+fn v03_echo_is_not_a_status_error_or_noise() {
+    let (mut bus, _peer) = peer(Fault::Echo);
+    assert!(bus.telemetry(&JOINT_IDS).is_ok());
+    assert_eq!(bus.last_sync.discarded, 0);
+    assert_eq!(bus.last_sync.rx_bytes, 16 * 21 + 8);
+}
+
+#[test]
+fn v03_imu_failures_never_proceed_to_the_servo_request() {
+    for fault in [
+        Fault::MissingImu,
+        Fault::WrongId,
+        Fault::Short,
+        Fault::Status,
+        Fault::Checksum,
+    ] {
+        let (mut bus, peer) = peer(fault);
+        assert!(bus.telemetry_partial(&JOINT_IDS).is_err());
+        assert_eq!(peer.requests.lock().unwrap().len(), 1);
+        assert_eq!(bus.last_sync.missing_ids, vec![IMU_ID]);
+        assert!(!bus.last_sync.partial_received);
+    }
+}
+
+#[test]
+fn v03_partial_requires_a_clean_ready_imu_and_keeps_the_missing_servo() {
+    let (mut bus, _peer) = peer(Fault::MissingServo);
+    let blocks = bus.telemetry_partial(&JOINT_IDS).unwrap();
+    assert_eq!(blocks.len(), 15);
+    assert!(blocks.contains_key(&IMU_ID));
+    assert_eq!(bus.last_sync.missing_ids, vec![JOINT_IDS[0]]);
+    assert!(bus.last_sync.partial_received);
+    for fault in [Fault::NoiseAndMissingServo, Fault::UnreadyAndMissingServo] {
+        let (mut bus, _peer) = peer(fault);
+        assert!(bus.telemetry_partial(&JOINT_IDS).is_err());
+        assert!(!bus.last_sync.partial_received);
+    }
+    let (mut bus, _peer) = peer(Fault::MissingServo);
+    assert!(bus.telemetry(&JOINT_IDS).is_err());
+}
+
+#[test]
+fn v03_read_only_does_not_get_two_separate_telemetry_budgets() {
+    let (mut bus, _peer) = peer(Fault::LateServos);
+    assert!(bus.telemetry(&JOINT_IDS).is_err());
+    assert!(bus.last_sync.deadline_exceeded);
+    assert_eq!(bus.last_sync.missing_ids.len(), 15);
+}
